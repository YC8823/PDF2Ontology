<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#CableAssembly> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ElectricalInterface> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Cage> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveTrim> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DiaphragmValve> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ElectricActuatorComponent> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ElectricalConnector> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ElectricalInterface> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ElectropneumaticActuatorComponent> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#FlowDivider> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveTrim> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Flowmeter> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#MeasuringSystem> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#GlobeValve> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Housing> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Plug> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveTrim> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#PneumaticActuatorComponent> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ProcessConnection> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Seal> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveTrim> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Seat> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveTrim> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Sensor> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasCompatibleValveActuator> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> ;
    owl:inverseOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasCompatibleValveBody> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimension> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent>,
        <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#FieldDevice> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionDecimalValue> a owl:DatatypeProperty ;
    rdfs:comment "The specific numerical value of the size, for example, 130, 222, 0.25, skip if it's a string." ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> ;
    rdfs:range xsd:decimal .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionEndAnchorX> a owl:DatatypeProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> ;
    rdfs:range xsd:decimal .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionEndAnchorY> a owl:DatatypeProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> ;
    rdfs:range xsd:decimal .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionParameterName> a owl:DatatypeProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> ;
    rdfs:range xsd:string .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionStartAnchorX> a owl:DatatypeProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> ;
    rdfs:range xsd:decimal .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionStartAnchorY> a owl:DatatypeProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> ;
    rdfs:range xsd:decimal .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionStringValue> a owl:DatatypeProperty ;
    rdfs:comment "The specific dimensional value besides of nummeric value, for example, \"H1+H2\" , \"1/2 G\"" ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> ;
    rdfs:range xsd:string .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionType> a owl:DatatypeProperty ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first "diameter" ;
                    rdf:rest [ a rdf:List ;
                            rdf:first "horizontal" ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first "other" ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first "vertical" ;
                                            rdf:rest () ] ] ] ] ] .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDimensionUnit> a owl:DatatypeProperty ;
    rdfs:comment "unit of the dimension, for example, \"mm\", \"inches\", \"kg\"" ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasElectricalInterface> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Transmitter> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ElectricalInterface> ;
    rdfs:subPropertyOf owl:topObjectProperty .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasModelName> a owl:DatatypeProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent>,
        <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#FieldDevice> ;
    rdfs:range xsd:string .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasNominalSizeDN> a owl:DatatypeProperty ;
    rdfs:comment "Nominal size of the valve, e.g. \"DN 15\", \"DN 150\"" ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> ;
    rdfs:range xsd:int .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasValveTrim> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ControlValve> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveTrim> ;
    rdfs:subPropertyOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#untitled-ontology-26> a owl:Ontology .

skos:altLabel a owl:AnnotationProperty .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ActuatingSystem> a owl:Class ;
    rdfs:comment "FINAL CONTROL ELEMENT, Conceptual layer: represents a class of devices that can perform actions" ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#FieldDevice> ;
    owl:disjointWith <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#MeasuringSystem> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Transmitter> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasCompatibleValveBody> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasValveActuator> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ControlValve> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> ;
    rdfs:subPropertyOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasValveBody> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ControlValve> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> ;
    rdfs:subPropertyOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#MeasuringSystem> a owl:Class ;
    rdfs:comment "Conceptual layer: represents a type of device that can perceive" ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#FieldDevice> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ControlValve> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> ;
            owl:onProperty <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasValveBody> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> ;
            owl:onProperty <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasValveActuator> ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ActuatingSystem> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ElectricalInterface> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#hasDeviceComponent> a owl:ObjectProperty ;
    rdfs:domain <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#FieldDevice> ;
    rdfs:range <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#FieldDevice> a owl:Class .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveActuator> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveTrim> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#Dimension> a owl:Class .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#ValveBody> a owl:Class ;
    rdfs:subClassOf <http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> .

<http://www.semanticweb.org/yanha/ontologies/2025/7/untitled-ontology-26#DeviceComponent> a owl:Class .



