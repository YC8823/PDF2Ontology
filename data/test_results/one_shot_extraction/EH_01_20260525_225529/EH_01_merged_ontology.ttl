#################################################################
# FieldDevice / Flowmeter and main components
#################################################################

:Flowmeter_Promag10P rdf:type :Flowmeter ;
    :hasModelName "Proline Promag 10P Electromagnetic Flow Measuring System" ;
    :hasDeviceComponent :Transmitter_Promag10_Remote ,
                        :Sensor_PromagP_Remote ,
                        :FlowmeterBody_Compact ,
                        :GroundDisk_ForFlangeConnections .

:Transmitter_Promag10_Remote rdf:type :DeviceComponent ;
    :hasModelName "Promag 10 transmitter, remote version" .

:Sensor_PromagP_Remote rdf:type :DeviceComponent ;
    :hasModelName "Promag P sensor, remote version" .

:FlowmeterBody_Compact rdf:type :DeviceComponent ;
    :hasModelName "Proline Promag 10P compact version flowmeter body" .

:GroundDisk_ForFlangeConnections rdf:type :DeviceComponent ;
    :hasModelName "Ground disk for flange connections for Promag 10P" .

